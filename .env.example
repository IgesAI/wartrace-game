# Copy to .env.local for local development. NEVER commit real values.
# Everything below is optional locally: with no DATABASE_URL the app uses embedded PGlite (Postgres in WASM).

# local | preview | production. Non-local deployments require DATABASE_URL and real 32+ char secrets;
# production additionally refuses demo fixtures and the development admin mock.
WARTRACE_DEPLOY_ENV=local

# Leave empty to use PGlite at PGLITE_DATA_DIR ("memory://" for an ephemeral in-memory database).
DATABASE_URL=
PGLITE_DATA_DIR=.data/pglite

# Local fallbacks are used when unset. Generate real values with: openssl rand -base64 48
GUEST_COOKIE_SIGNING_SECRET=
ADMIN_AUTH_SECRET=
ADMIN_AUTH_PROVIDER=development_mock_only

NEXT_PUBLIC_BASE_URL=http://localhost:3000
GAME_TIME_ZONE=America/New_York

# Seeds and publishes clearly-labelled DEMO operations on startup (local/preview only).
GAME_DEV_FIXTURE_MODE=true
# Local-only: shorten the 25 s round timer for manual testing (3–120).
GAME_ROUND_SECONDS_OVERRIDE=

SCENE_ASSET_BASE_PATH=/worlds/western-front

# First-party, schema-validated analytics events (no free text). Off by default.
ANALYTICS_ENABLED=false
ERROR_MONITORING_DSN=
